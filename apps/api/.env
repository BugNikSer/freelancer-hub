PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelancer_hub"

# Better-Auth (сгенерируйте случайную строку от 32 символов)
BETTER_AUTH_SECRET="super_secret_random_string_at_least_32_chars_long"
BETTER_AUTH_URL="http://localhost:3000"

# S3 / RustFS
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="freelancer-hub"
S3_ACCESS_KEY="rustfsadmin"
S3_SECRET_KEY="rustfsadmin"